# Do not modify this file!  It was generated by ‘nixos-generate-config’
# and may be overwritten by future invocations.  Please make changes
# to /etc/nixos/configuration.nix instead.
{ config, lib, pkgs, modulesPath, ... }:

{
  imports =
    [ (modulesPath + "/installer/scan/not-detected.nix")
    ];

  boot.initrd.availableKernelModules = [ "vmd" "xhci_pci" "ahci" "nvme" "usbhid" "usb_storage" "uas" "sd_mod" ];
  boot.initrd.kernelModules = [ ];
  boot.kernelModules = [ "kvm-intel" ];
  boot.extraModulePackages = [ ];

  fileSystems."/" =
    { device = "/dev/mapper/luks-bd950db0-dc83-432a-bec6-0bc1a72bd76e";
      fsType = "ext4";
    };

  boot.initrd.luks.devices."luks-bd950db0-dc83-432a-bec6-0bc1a72bd76e".device = "/dev/disk/by-uuid/bd950db0-dc83-432a-bec6-0bc1a72bd76e";

  fileSystems."/boot" =
    { device = "/dev/disk/by-uuid/F9F7-7BCD";
      fsType = "vfat";
      options = [ "fmask=0077" "dmask=0077" ];
    };

  # The separate encrypted swap partition is not configured for unattended
  # unlock. zram and /var/lib/swapfile provide swap without a boot-time wait.

  nixpkgs.hostPlatform = lib.mkDefault "x86_64-linux";
  hardware.cpu.intel.updateMicrocode = lib.mkDefault config.hardware.enableRedistributableFirmware;
}
