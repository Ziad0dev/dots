{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "display": {
    "color": {
      "keys": "38;2;51;177;255",
      "title": "38;2;238;83;150"
    },
    "separator": " "
  },
  "logo": {
    "height": 11,
    "padding": {
      "left": 2,
      "right": 3,
      "top": 1
    },
    "preserveAspectRatio": true,
    "source": "/home/ziad0dev/dots/config/quickshell/rise/assets/nixos-logo.png",
    "type": "kitty",
    "width": 22
  },
  "modules": [
    "break",
    {
      "format": "{user-name}@{host-name}",
      "type": "title"
    },
    {
      "outputColor": "38;2;190;149;255",
      "string": "─",
      "type": "separator"
    },
    {
      "key": "  os",
      "type": "os"
    },
    {
      "format": "{release}",
      "key": "  kernel",
      "type": "kernel"
    },
    {
      "key": "  wm",
      "type": "wm"
    },
    {
      "key": "  shell",
      "type": "shell"
    },
    {
      "key": "  term",
      "type": "terminal"
    },
    {
      "key": "  uptime",
      "type": "uptime"
    },
    {
      "outputColor": "38;2;190;149;255",
      "string": "─",
      "type": "separator"
    },
    {
      "key": "  cpu",
      "type": "cpu"
    },
    {
      "format": "{name}",
      "key": "  gpu",
      "type": "gpu"
    },
    {
      "key": "  mem",
      "type": "memory"
    },
    {
      "key": "  swap",
      "type": "swap"
    },
    {
      "folders": "/",
      "key": "  disk",
      "type": "disk"
    },
    {
      "outputColor": "38;2;190;149;255",
      "string": "─",
      "type": "separator"
    },
    {
      "symbol": "circle",
      "type": "colors"
    },
    "break"
  ]
}
