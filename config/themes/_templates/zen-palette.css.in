:root {
    --dots-color-scheme: dark;
    --dots-background: ${background};
    --dots-on_background: ${foreground};
    --dots-surface: ${background};
    --dots-surface_dim: ${base00};
    --dots-surface_bright: ${base02};
    --dots-surface_variant: ${base02};
    --dots-surface_container_lowest: ${base00};
    --dots-surface_container_low: ${surface};
    --dots-surface_container: ${base01};
    --dots-surface_container_high: ${base02};
    --dots-surface_container_highest: ${base03};
    --dots-on_surface: ${foreground};
    --dots-on_surface_variant: ${dim};
    --dots-on_surface_container: ${foreground};
    --dots-outline: ${muted};
    --dots-outline_variant: ${base02};
    --dots-primary: ${accent};
    --dots-on_primary: ${background};
    --dots-primary_container: ${accent_container};
    --dots-on_primary_container: ${foreground};
    --dots-primary_fixed: ${accent};
    --dots-primary_fixed_dim: ${accent_dim};
    --dots-secondary: ${blue};
    --dots-on_secondary: ${background};
    --dots-secondary_container: ${base02};
    --dots-on_secondary_container: ${foreground};
    --dots-secondary_fixed: ${blue};
    --dots-secondary_fixed_dim: ${blue};
    --dots-on_secondary_fixed_variant: ${background};
    --dots-tertiary: ${magenta};
    --dots-on_tertiary: ${background};
    --dots-tertiary_container: ${base02};
    --dots-on_tertiary_container: ${foreground};
    --dots-error: ${red};
    --dots-on_error: ${background};
    --dots-error_container: ${base02};
    --dots-on_error_container: ${red};
    --dots-inverse_surface: ${foreground};
    --dots-inverse_on_surface: ${background};
    --dots-on_primary_rgb: ${background_rgb};
    --dots-on_surface_rgb: ${foreground_rgb};
    --dots-outline_rgb: ${muted_rgb};
    --dots-primary_rgb: ${accent_rgb};
    --dots-primary_container_rgb: ${accent_container_rgb};
    --dots-secondary_rgb: ${blue_rgb};
    --dots-surface_rgb: ${background_rgb};
    --dots-surface_container_rgb: ${base01_rgb};
    --dots-surface_container_high_rgb: ${base02_rgb};
    --dots-surface_container_low_rgb: ${surface_rgb};
}
