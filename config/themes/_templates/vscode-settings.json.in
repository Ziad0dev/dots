{
  "editor.fontFamily": "'JetBrainsMono Nerd Font', 'FiraCode Nerd Font', monospace",
  "editor.fontLigatures": true,
  "editor.fontSize": 14,
  "editor.lineHeight": 1.5,
  "editor.renderWhitespace": "boundary",
  "editor.rulers": [80, 120],
  "editor.bracketPairColorization.enabled": true,
  "editor.cursorBlinking": "solid",
  "editor.cursorSmoothCaretAnimation": "off",
  "editor.minimap.enabled": false,
  "editor.formatOnSave": true,
  "editor.stickyScroll.enabled": true,
  "editor.inlineSuggest.enabled": true,

  "files.trimTrailingWhitespace": true,
  "files.insertFinalNewline": true,
  "files.trimFinalNewlines": true,
  "files.autoSave": "onFocusChange",

  "terminal.integrated.fontFamily": "'JetBrainsMono Nerd Font'",
  "terminal.integrated.fontSize": 13,
  "terminal.integrated.defaultProfile.linux": "fish",
  "terminal.integrated.profiles.linux": {
    "fish": { "path": "fish" }
  },

  "workbench.startupEditor": "none",
  "workbench.colorTheme": "Default Dark Modern",
  "workbench.iconTheme": "material-icon-theme",
  "workbench.list.smoothScrolling": true,
  "workbench.editor.enablePreview": false,
  "workbench.tree.indent": 14,

  "window.titleBarStyle": "custom",
  "window.menuBarVisibility": "toggle",
  "window.commandCenter": false,

  "explorer.confirmDelete": false,
  "explorer.confirmDragAndDrop": false,

  "telemetry.telemetryLevel": "off",
  "update.mode": "none",
  "extensions.autoUpdate": false,
  "git.autofetch": true,
  "git.confirmSync": false,

  "nix.enableLanguageServer": true,
  "nix.serverPath": "nixd",

  "workbench.colorCustomizations": {
    "editor.background": "${background}",
    "editor.foreground": "${foreground}",
    "editorCursor.foreground": "${cursor}",
    "editor.selectionBackground": "${selection_background}",
    "editor.selectionForeground": "${selection_foreground}",
    "editor.lineHighlightBackground": "${surface}",
    "editorLineNumber.foreground": "${dim}",
    "editorLineNumber.activeForeground": "${accent}",
    "editorIndentGuide.background1": "${surface}",
    "editorIndentGuide.activeBackground1": "${dim}",
    "editorWhitespace.foreground": "${surface}",
    "editorRuler.foreground": "${surface}",

    "editorError.foreground": "${color1}",
    "editorWarning.foreground": "${color3}",
    "editorInfo.foreground": "${color4}",

    "sideBar.background": "${background}",
    "sideBar.foreground": "${muted}",
    "sideBar.border": "${surface}",
    "sideBarTitle.foreground": "${foreground}",
    "sideBarSectionHeader.background": "${background}",
    "sideBarSectionHeader.foreground": "${muted}",

    "activityBar.background": "${background}",
    "activityBar.foreground": "${foreground}",
    "activityBar.inactiveForeground": "${dim}",
    "activityBar.border": "${surface}",
    "activityBarBadge.background": "${accent}",
    "activityBarBadge.foreground": "${background}",

    "editorGroupHeader.tabsBackground": "${background}",
    "tab.activeBackground": "${surface}",
    "tab.activeForeground": "${foreground}",
    "tab.inactiveBackground": "${background}",
    "tab.inactiveForeground": "${dim}",
    "tab.activeBorderTop": "${accent}",
    "tab.border": "${background}",

    "statusBar.background": "${background}",
    "statusBar.foreground": "${muted}",
    "statusBar.border": "${surface}",
    "statusBar.noFolderBackground": "${background}",
    "statusBar.debuggingBackground": "${color5}",
    "statusBarItem.remoteBackground": "${accent}",
    "statusBarItem.remoteForeground": "${background}",

    "titleBar.activeBackground": "${background}",
    "titleBar.activeForeground": "${foreground}",
    "titleBar.inactiveBackground": "${background}",
    "titleBar.inactiveForeground": "${dim}",
    "titleBar.border": "${surface}",

    "panel.background": "${background}",
    "panel.border": "${surface}",
    "panelTitle.activeForeground": "${foreground}",
    "panelTitle.inactiveForeground": "${dim}",

    "terminal.background": "${background}",
    "terminal.foreground": "${foreground}",
    "terminal.ansiBlack": "${color0}",
    "terminal.ansiRed": "${color1}",
    "terminal.ansiGreen": "${color2}",
    "terminal.ansiYellow": "${color3}",
    "terminal.ansiBlue": "${color4}",
    "terminal.ansiMagenta": "${color5}",
    "terminal.ansiCyan": "${color6}",
    "terminal.ansiWhite": "${color7}",
    "terminal.ansiBrightBlack": "${color8}",
    "terminal.ansiBrightRed": "${color9}",
    "terminal.ansiBrightGreen": "${color10}",
    "terminal.ansiBrightYellow": "${color11}",
    "terminal.ansiBrightBlue": "${color12}",
    "terminal.ansiBrightMagenta": "${color13}",
    "terminal.ansiBrightCyan": "${color14}",
    "terminal.ansiBrightWhite": "${color15}",
    "terminalCursor.foreground": "${cursor}",

    "input.background": "${surface}",
    "input.foreground": "${foreground}",
    "input.border": "${surface}",
    "inputOption.activeBorder": "${accent}",
    "dropdown.background": "${surface}",
    "dropdown.foreground": "${foreground}",
    "dropdown.border": "${surface}",

    "quickInput.background": "${background}",
    "quickInput.foreground": "${foreground}",
    "quickInputList.focusBackground": "${surface}",
    "quickInputList.focusForeground": "${accent}",

    "list.activeSelectionBackground": "${surface}",
    "list.activeSelectionForeground": "${accent}",
    "list.inactiveSelectionBackground": "${surface}",
    "list.hoverBackground": "${surface}",
    "list.highlightForeground": "${accent}",

    "scrollbarSlider.background": "${surface}",
    "scrollbarSlider.hoverBackground": "${dim}",
    "scrollbarSlider.activeBackground": "${dim}",

    "button.background": "${accent}",
    "button.foreground": "${background}",
    "button.hoverBackground": "${color4}",

    "focusBorder": "${accent}",
    "foreground": "${foreground}",
    "widget.border": "${surface}",
    "editorWidget.background": "${background}",
    "editorWidget.border": "${surface}",
    "editorSuggestWidget.background": "${background}",
    "editorSuggestWidget.selectedBackground": "${surface}",
    "editorHoverWidget.background": "${background}",
    "editorHoverWidget.border": "${surface}",

    "peekViewEditor.background": "${background}",
    "peekViewResult.background": "${background}",
    "diffEditor.insertedTextBackground": "${surface}",
    "diffEditor.removedTextBackground": "${surface}",

    "gitDecoration.modifiedResourceForeground": "${color3}",
    "gitDecoration.deletedResourceForeground": "${color1}",
    "gitDecoration.untrackedResourceForeground": "${color2}",
    "gitDecoration.ignoredResourceForeground": "${dim}",
    "gitDecoration.conflictingResourceForeground": "${color5}",

    "notifications.background": "${background}",
    "notifications.border": "${surface}",
    "notificationCenterHeader.background": "${background}",

    "breadcrumb.foreground": "${dim}",
    "breadcrumb.focusForeground": "${foreground}",
    "menu.background": "${background}",
    "menu.foreground": "${foreground}",
    "menu.selectionBackground": "${surface}",
    "menu.border": "${surface}"
  }
}
