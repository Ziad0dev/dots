;; generated by themectl from the ${scheme} palette; loaded by ~/.config/nyxt/config.lisp
(in-package #:nyxt-user)

(defparameter *dots-theme*
  (make-instance 'theme:theme
                 :background-color-   "${base01}"
                 :background-color    "${background}"
                 :background-color+   "${base02}"
                 :on-background-color "${foreground}"
                 :primary-color-      "${accent_dim}"
                 :primary-color       "${accent}"
                 :primary-color+      "${accent}"
                 :on-primary-color    "${background}"
                 :secondary-color-    "${surface}"
                 :secondary-color     "${base01}"
                 :secondary-color+    "${base02}"
                 :on-secondary-color  "${foreground}"
                 :action-color-       "${accent_dim}"
                 :action-color        "${accent}"
                 :action-color+       "${blue}"
                 :on-action-color     "${background}"
                 :highlight-color-    "${accent_container}"
                 :highlight-color     "${magenta}"
                 :highlight-color+    "${pink}"
                 :on-highlight-color  "${background}"
                 :success-color-      "${green}"
                 :success-color       "${green}"
                 :success-color+      "${cyan}"
                 :on-success-color    "${background}"
                 :warning-color-      "${yellow}"
                 :warning-color       "${red}"
                 :warning-color+      "${red}"
                 :on-warning-color    "${background}"
                 :font-family         "Inter, sans-serif"
                 :monospace-font-family "JetBrainsMono Nerd Font, monospace"))

(defparameter *dots-scheme* "${scheme}")
