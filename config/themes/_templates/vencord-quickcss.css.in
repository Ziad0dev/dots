:root,
html,
body,
[class*="theme-"] {
  --dots-l0: ${background};
  --dots-l1: ${surface};
  --dots-edge: color-mix(in srgb, ${foreground} 13%, ${background});
  --dots-frame: color-mix(in srgb, ${foreground} 22%, ${background});
  --dots-hover: ${accent}1a;
  --dots-active: ${accent}2e;
  --dots-idle: #0000001f;
  --dots-weak: ${foreground}0d;

  --font-code: "JetBrainsMono Nerd Font", monospace;

  --radius-xs: 4px;
  --radius-sm: 6px;
  --radius-md: 6px;
  --radius-lg: 8px;
  --radius-xl: 12px;

  --primary-100: color-mix(in srgb, ${foreground} 100%, ${background}) !important;
  --primary-130: color-mix(in srgb, ${foreground} 96%, ${background}) !important;
  --primary-160: color-mix(in srgb, ${foreground} 92%, ${background}) !important;
  --primary-200: color-mix(in srgb, ${foreground} 88%, ${background}) !important;
  --primary-230: color-mix(in srgb, ${foreground} 84%, ${background}) !important;
  --primary-260: color-mix(in srgb, ${foreground} 80%, ${background}) !important;
  --primary-300: color-mix(in srgb, ${foreground} 75%, ${background}) !important;
  --primary-330: color-mix(in srgb, ${foreground} 71%, ${background}) !important;
  --primary-360: color-mix(in srgb, ${foreground} 68%, ${background}) !important;
  --primary-400: color-mix(in srgb, ${foreground} 62%, ${background}) !important;
  --primary-430: color-mix(in srgb, ${foreground} 59%, ${background}) !important;
  --primary-460: color-mix(in srgb, ${foreground} 55%, ${background}) !important;
  --primary-500: color-mix(in srgb, ${foreground} 50%, ${background}) !important;
  --primary-530: color-mix(in srgb, ${foreground} 46%, ${background}) !important;
  --primary-560: color-mix(in srgb, ${foreground} 42%, ${background}) !important;
  --primary-600: color-mix(in srgb, ${foreground} 38%, ${background}) !important;
  --primary-630: color-mix(in srgb, ${foreground} 34%, ${background}) !important;
  --primary-645: color-mix(in srgb, ${foreground} 32%, ${background}) !important;
  --primary-660: color-mix(in srgb, ${foreground} 30%, ${background}) !important;
  --primary-700: color-mix(in srgb, ${foreground} 25%, ${background}) !important;
  --primary-730: color-mix(in srgb, ${foreground} 21%, ${background}) !important;
  --primary-745: color-mix(in srgb, ${foreground} 19%, ${background}) !important;
  --primary-760: color-mix(in srgb, ${foreground} 18%, ${background}) !important;
  --primary-800: color-mix(in srgb, ${foreground} 12%, ${background}) !important;
  --primary-830: color-mix(in srgb, ${foreground} 9%, ${background}) !important;
  --primary-845: color-mix(in srgb, ${foreground} 7%, ${background}) !important;
  --primary-860: color-mix(in srgb, ${foreground} 5%, ${background}) !important;
  --primary-900: color-mix(in srgb, ${foreground} 0%, ${background}) !important;

  --brand-100: color-mix(in srgb, ${accent} 60%, ${background}) !important;
  --brand-130: color-mix(in srgb, ${accent} 63%, ${background}) !important;
  --brand-160: color-mix(in srgb, ${accent} 66%, ${background}) !important;
  --brand-200: color-mix(in srgb, ${accent} 70%, ${background}) !important;
  --brand-230: color-mix(in srgb, ${accent} 73%, ${background}) !important;
  --brand-260: color-mix(in srgb, ${accent} 76%, ${background}) !important;
  --brand-300: color-mix(in srgb, ${accent} 80%, ${background}) !important;
  --brand-330: color-mix(in srgb, ${accent} 83%, ${background}) !important;
  --brand-360: color-mix(in srgb, ${accent} 86%, ${background}) !important;
  --brand-400: color-mix(in srgb, ${accent} 90%, ${background}) !important;
  --brand-430: color-mix(in srgb, ${accent} 93%, ${background}) !important;
  --brand-460: color-mix(in srgb, ${accent} 96%, ${background}) !important;
  --brand-500: color-mix(in srgb, ${accent} 100%, ${background}) !important;
  --brand-530: color-mix(in srgb, ${accent} 97%, ${background}) !important;
  --brand-560: color-mix(in srgb, ${accent} 94%, ${background}) !important;
  --brand-600: color-mix(in srgb, ${accent} 90%, ${background}) !important;
  --brand-630: color-mix(in srgb, ${accent} 87%, ${background}) !important;
  --brand-660: color-mix(in srgb, ${accent} 84%, ${background}) !important;
  --brand-700: color-mix(in srgb, ${accent} 80%, ${background}) !important;
  --brand-730: color-mix(in srgb, ${accent} 77%, ${background}) !important;
  --brand-760: color-mix(in srgb, ${accent} 74%, ${background}) !important;
  --brand-800: color-mix(in srgb, ${accent} 70%, ${background}) !important;

  --bg-base-primary: var(--dots-l0) !important;
  --bg-base-tertiary: var(--dots-l0) !important;
  --background-tertiary: var(--dots-l0) !important;
  --background-accent: var(--dots-l0) !important;
  --bg-overlay-app-frame: var(--dots-l0) !important;
  --channeltextarea-background: var(--dots-l0) !important;
  --input-background: var(--dots-l0) !important;
  --button-secondary-background: var(--dots-l0) !important;
  --deprecated-quickswitcher-input-background: var(--dots-l0) !important;

  --background-primary: var(--dots-l1) !important;
  --background-secondary: var(--dots-l1) !important;
  --background-secondary-alt: var(--dots-l1) !important;
  --background-floating: var(--dots-l1) !important;
  --background-nested-floating: var(--dots-l1) !important;
  --background-mobile-primary: var(--dots-l1) !important;
  --background-mobile-secondary: var(--dots-l1) !important;
  --bg-base-secondary: var(--dots-l1) !important;
  --bg-surface-overlay: var(--dots-l1) !important;
  --bg-surface-raised: var(--dots-l1) !important;
  --bg-overlay-chat: var(--dots-l1) !important;
  --bg-overlay-home: var(--dots-l1) !important;
  --bg-overlay-floating: var(--dots-l1) !important;
  --bg-overlay-1: var(--dots-l1) !important;
  --bg-overlay-2: var(--dots-l1) !important;
  --bg-overlay-3: var(--dots-l1) !important;
  --bg-overlay-4: var(--dots-l1) !important;
  --bg-overlay-5: var(--dots-l1) !important;
  --bg-overlay-6: var(--dots-l1) !important;
  --home-background: var(--dots-l1) !important;
  --modal-background: var(--dots-l1) !important;
  --modal-footer-background: var(--dots-l1) !important;
  --chat-background: var(--dots-l1) !important;
  --chat-input-container-background: var(--dots-l1) !important;
  --activity-card-background: var(--dots-l1) !important;
  --deprecated-panel-background: var(--dots-l1) !important;

  --background-message-hover: ${accent}12 !important;
  --background-modifier-hover: var(--dots-hover) !important;
  --background-modifier-active: var(--dots-active) !important;
  --background-modifier-selected: var(--dots-active) !important;
  --background-modifier-accent: var(--dots-edge) !important;
  --bg-mod-faint: transparent !important;
  --bg-mod-subtle: var(--dots-weak) !important;
  --bg-mod-strong: var(--dots-active) !important;
  --bg-overlay-hover: var(--dots-hover) !important;
  --bg-overlay-selected: var(--dots-active) !important;
  --bg-overlay-active: var(--dots-active) !important;
  --background-mentioned: ${accent}14 !important;
  --background-mentioned-hover: ${accent}20 !important;

  --elevation-low: none !important;
  --elevation-medium: 0 2px 10px rgba(0, 0, 0, 0.46) !important;
  --elevation-high: 0 8px 24px rgba(0, 0, 0, 0.55) !important;
  --border-faint: var(--dots-edge) !important;
  --border-subtle: var(--dots-edge) !important;
  --border-strong: var(--dots-frame) !important;
  --chat-border: var(--dots-edge) !important;

  --text-normal: ${foreground} !important;
  --text-default: ${foreground} !important;
  --text-primary: ${foreground} !important;
  --text-secondary: ${dim} !important;
  --text-tertiary: ${muted} !important;
  --text-muted: ${dim} !important;
  --text-link: ${accent} !important;
  --text-brand: ${accent} !important;
  --text-positive: ${green} !important;
  --text-warning: ${yellow} !important;
  --text-danger: ${red} !important;
  --content-primary: ${foreground} !important;
  --content-secondary: ${dim} !important;
  --header-primary: ${foreground} !important;
  --header-secondary: ${dim} !important;
  --icon-primary: ${foreground} !important;
  --icon-secondary: ${dim} !important;
  --icon-tertiary: ${muted} !important;
  --channels-default: ${dim} !important;
  --channel-icon: ${muted} !important;
  --channel-text-area-placeholder: ${muted} !important;
  --interactive-normal: ${foreground} !important;
  --interactive-hover: ${accent} !important;
  --interactive-active: ${accent} !important;
  --interactive-muted: ${muted} !important;

  --brand-experiment: ${accent} !important;
  --brand-experiment-360: ${accent} !important;
  --brand-experiment-500: ${accent} !important;
  --brand-experiment-560: ${accent} !important;
  --brand-experiment-600: ${accent} !important;
  --button-filled-brand-background: ${accent} !important;
  --button-filled-brand-background-hover: color-mix(in srgb, ${accent} 80%, ${foreground}) !important;
  --button-filled-brand-text: ${background} !important;
  --control-brand-foreground: ${accent} !important;
  --focus-primary: ${accent} !important;
  --mention-foreground: ${accent} !important;
  --mention-background: ${accent}20 !important;
  --status-danger: ${red} !important;
  --status-warning: ${yellow} !important;
  --status-positive: ${green} !important;
  --info-help-background: ${accent}14 !important;
  --info-help-foreground: ${accent} !important;
  --scrollbar-thin-thumb: ${dim}55 !important;
  --scrollbar-thin-track: transparent !important;
  --scrollbar-auto-thumb: ${dim}55 !important;
  --scrollbar-auto-track: transparent !important;
  --guild-boosting-pink: ${magenta} !important;
}

[class*="appMount"],
[class*="app_"],
[class*="appAsidePanelWrapper"],
[class*="notAppAsidePanel"],
[class*="baseLayer"],
[class*="layers_"] {
  background-color: var(--dots-l0) !important;
  border-radius: 0 !important;
}

[class*="bg_"],
[class*="chatContent"],
[class*="messagesWrapper"],
[class*="chat_"],
[class*="content_"],
[class*="page_"],
[class*="sidebar_"],
[class*="sidebarList"],
[class*="membersWrap"],
[class*="members_"],
[class*="panels_"],
[class*="username"],
[class*="roleColor"] {
  color: ${foreground} !important;
}

[class*="guilds_"],
[class*="guildsWrapper"] {
  background-color: var(--dots-l0) !important;
  border: none !important;
  box-shadow: none !important;
}

[class*="sidebar_"],
[class*="sidebarList"] {
  background-color: var(--dots-l1) !important;
  border: none !important;
  border-right: 1px solid var(--dots-edge) !important;
  box-shadow: none !important;
}

[class*="membersWrap"] {
  background-color: var(--dots-l1) !important;
  border: none !important;
  border-left: 1px solid var(--dots-edge) !important;
  box-shadow: none !important;
}

[class*="title_"][class*="container__"] {
  background-color: var(--dots-l1) !important;
  border-bottom: 1px solid var(--dots-edge) !important;
  box-shadow: none !important;
}

[class*="title_"],
[class*="subtitle"],
[class*="upperContainer"] {
  box-shadow: none !important;
}

[class*="container_"] > [class*="scroller_"] {
  background-color: var(--dots-l1) !important;
}

[class*="channelTextArea"],
[class*="scrollableContainer"] {
  background-color: var(--dots-l0) !important;
  border: 1px solid var(--dots-edge) !important;
  border-radius: var(--radius-sm) !important;
}

[class*="separator"],
[class*="divider"] {
  border-color: var(--dots-edge) !important;
  background-color: var(--dots-edge) !important;
}

[class*="modal_"],
[class*="root_"][class*="fullscreenOnMobile"],
[class*="menu_"],
[class*="layerContainer"] > [class*="layer_"] > [class*="container_"] {
  background-color: var(--dots-l1) !important;
  border: 1px solid var(--dots-frame) !important;
  border-radius: var(--radius-sm) !important;
}

code,
.hljs,
pre,
[class*="markup_"] code,
[class*="markup_"] pre {
  background: var(--dots-l0) !important;
  color: ${foreground} !important;
  border: 1px solid var(--dots-edge) !important;
  border-radius: var(--radius-xs) !important;
  font-family: var(--font-code) !important;
}

::-webkit-scrollbar-thumb {
  background-color: ${dim}55 !important;
  border-color: transparent !important;
  border-radius: var(--radius-xs) !important;
}

::selection {
  background: ${accent}44 !important;
  color: ${foreground} !important;
}

[class*="member_"],
[class*="memberInner"],
[class*="nameAndDecorators"],
[class*="roleColor"],
[class*="activityText"] {
  background-color: transparent !important;
}

[class*="nameplate"],
[class*="Nameplate"],
[class*="memberBackground"],
[class*="decorationBackground"] {
  background: none !important;
  background-image: none !important;
  background-color: transparent !important;
  mask-image: none !important;
}

[class*="animatedContainer"],
[class*="header_"] [class*="banner"],
[class*="guildHeader"],
[class*="headerContent"],
[class*="toolbar_"],
[class*="wordmark"] {
  background-color: transparent !important;
  background-image: none !important;
}

[class*="membersWrap"] *,
[class*="memberList"] *,
[class*="privateChannels"] * {
  background-image: none !important;
}

[class*="membersWrap"] [class*="member_"],
[class*="membersWrap"] [class*="memberInner"],
[class*="membersWrap"] [class*="layout_"],
[class*="membersWrap"] [class*="content_"],
[class*="membersWrap"] [class*="nameAndDecorators"],
[class*="membersWrap"] [class*="username"],
[class*="membersWrap"] [class*="roleColor"],
[class*="membersWrap"] [class*="avatar"],
[class*="membersWrap"] [class*="container_"] {
  background-color: transparent !important;
  box-shadow: none !important;
}

[class*="membersWrap"] [class*="layout_"]:hover,
[class*="membersWrap"] [class*="member_"]:hover {
  background-color: var(--dots-hover) !important;
}

[class*="username"],
[class*="nameAndDecorators"],
[class*="headerText"] [class*="username"] {
  background-color: transparent !important;
  background-image: none !important;
}
