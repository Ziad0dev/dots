#:schema https://yazi-rs.github.io/schemas/theme.json

[mgr]
cwd             = { fg = "${cyan}" }
find_keyword    = { fg = "${yellow}", bold = true, italic = true, underline = true }
find_position   = { fg = "${magenta}", bg = "reset", bold = true, italic = true }
marker_copied   = { fg = "${green}", bg = "${green}" }
marker_cut      = { fg = "${red}", bg = "${red}" }
marker_marked   = { fg = "${cyan}", bg = "${cyan}" }
marker_selected = { fg = "${yellow}", bg = "${yellow}" }
count_copied    = { fg = "${bg}", bg = "${green}" }
count_cut       = { fg = "${bg}", bg = "${red}" }
count_selected  = { fg = "${bg}", bg = "${yellow}" }
border_symbol   = "│"
border_style    = { fg = "${dim}" }

[indicator]
parent  = { fg = "${muted}" }
current = { reversed = true }
preview = { bg = "${surface}" }

[tabs]
active   = { fg = "${bg}", bg = "${accent}", bold = true }
inactive = { fg = "${muted}", bg = "${surface}" }

[mode]
normal_main = { fg = "${bg}", bg = "${accent}", bold = true }
normal_alt  = { fg = "${accent}", bg = "${surface}" }
select_main = { fg = "${bg}", bg = "${green}", bold = true }
select_alt  = { fg = "${green}", bg = "${surface}" }
unset_main  = { fg = "${bg}", bg = "${magenta}", bold = true }
unset_alt   = { fg = "${magenta}", bg = "${surface}" }

[status]
overall         = { fg = "${fg}" }
sep_left        = { open = "", close = "" }
sep_right       = { open = "", close = "" }
perm_type       = { fg = "${blue}" }
perm_read       = { fg = "${yellow}" }
perm_write      = { fg = "${red}" }
perm_exec       = { fg = "${green}" }
perm_sep        = { fg = "${dim}" }
progress_label  = { fg = "${fg}", bold = true }
progress_normal = { fg = "${accent}", bg = "${surface}" }
progress_error  = { fg = "${red}", bg = "${surface}" }

[which]
cols            = 3
mask            = { bg = "${surface}" }
cand            = { fg = "${cyan}" }
rest            = { fg = "${muted}" }
desc            = { fg = "${fg}" }
separator       = "  ▸  "
separator_style = { fg = "${dim}" }

[confirm]
border  = { fg = "${accent}" }
title   = { fg = "${accent}" }
list    = { fg = "${cyan}" }
btn_yes = { fg = "${bg}", bg = "${accent}", bold = true }
btn_no  = { fg = "${fg}" }

[spot]
border   = { fg = "${accent}" }
title    = { fg = "${accent}" }
tbl_col  = { fg = "${cyan}", bold = true }
tbl_cell = { fg = "${fg}" }

[notify]
title_info  = { fg = "${green}" }
title_warn  = { fg = "${yellow}" }
title_error = { fg = "${red}" }

[pick]
border   = { fg = "${accent}" }
active   = { fg = "${magenta}", bold = true }
inactive = { fg = "${fg}" }

[input]
border   = { fg = "${accent}" }
title    = { fg = "${fg}" }
value    = { fg = "${fg}" }
selected = { reversed = true }

[cmp]
border       = { fg = "${accent}" }
active       = { fg = "${magenta}", bold = true }
inactive     = { fg = "${fg}" }
icon_file    = ""
icon_folder  = ""
icon_command = ""

[tasks]
border  = { fg = "${accent}" }
title   = { fg = "${fg}" }
hovered = { fg = "${magenta}", underline = true }

[filetype]
rules = [
	{ mime = "image/*", fg = "${cyan}" },
	{ mime = "{audio,video}/*", fg = "${magenta}" },
	{ mime = "application/{zip,rar,7z*,tar,gzip,xz,zstd,bzip*,lzma,compress,archive,cpio,arj,xar,ms-cab*}", fg = "${red}" },
	{ mime = "application/{pdf,epub*,doc*,rtf}", fg = "${yellow}" },
	{ url = "*", is = "orphan", fg = "${red}" },
	{ url = "*", is = "exec", fg = "${green}" },
	{ url = "*/", fg = "${blue}", bold = true },
	{ url = "*", fg = "${fg}" },
]
