{
  "name": "Dots",
  "type": "dark",
  "semanticHighlighting": true,
  "colors": {
    "foreground": "${foreground}",
    "descriptionForeground": "${muted}",
    "disabledForeground": "${dim}",
    "errorForeground": "${red}",
    "focusBorder": "${accent}80",
    "contrastBorder": "${base02}",
    "icon.foreground": "${foreground}",
    "selection.background": "${selection_background}66",
    "widget.border": "${base02}",
    "widget.shadow": "#00000080",
    "sash.hoverBorder": "${accent}",
    "progressBar.background": "${accent}",
    "textLink.foreground": "${accent}",
    "textLink.activeForeground": "${cyan}",

    "editor.background": "${background}",
    "editor.foreground": "${foreground}",
    "editorCursor.foreground": "${cursor}",
    "editor.lineHighlightBackground": "${surface}",
    "editor.lineHighlightBorder": "${surface}",
    "editor.selectionBackground": "${selection_background}55",
    "editor.selectionHighlightBackground": "${selection_background}30",
    "editor.inactiveSelectionBackground": "${selection_background}30",
    "editor.wordHighlightBackground": "${base02}",
    "editor.wordHighlightStrongBackground": "${base02}",
    "editor.findMatchBackground": "${yellow}55",
    "editor.findMatchHighlightBackground": "${yellow}30",
    "editor.rangeHighlightBackground": "${surface}",
    "editorLineNumber.foreground": "${base03}",
    "editorLineNumber.activeForeground": "${accent}",
    "editorWhitespace.foreground": "${base02}",
    "editorIndentGuide.background1": "${base02}",
    "editorIndentGuide.activeBackground1": "${base03}",
    "editorRuler.foreground": "${base02}",
    "editorBracketMatch.background": "${accent}30",
    "editorBracketMatch.border": "${accent}",
    "editorBracketHighlight.foreground1": "${blue}",
    "editorBracketHighlight.foreground2": "${magenta}",
    "editorBracketHighlight.foreground3": "${yellow}",
    "editorBracketHighlight.foreground4": "${cyan}",
    "editorBracketHighlight.foreground5": "${green}",
    "editorBracketHighlight.foreground6": "${pink}",
    "editorError.foreground": "${red}",
    "editorWarning.foreground": "${yellow}",
    "editorInfo.foreground": "${blue}",
    "editorHint.foreground": "${cyan}",
    "editorInlayHint.foreground": "${muted}",
    "editorInlayHint.background": "${surface}",
    "editorCodeLens.foreground": "${muted}",
    "editorGutter.addedBackground": "${green}",
    "editorGutter.modifiedBackground": "${blue}",
    "editorGutter.deletedBackground": "${red}",
    "editorOverviewRuler.border": "${background}",
    "editorWidget.background": "${base01}",
    "editorWidget.foreground": "${foreground}",
    "editorWidget.border": "${base02}",
    "editorSuggestWidget.background": "${base01}",
    "editorSuggestWidget.border": "${base02}",
    "editorSuggestWidget.foreground": "${foreground}",
    "editorSuggestWidget.highlightForeground": "${accent}",
    "editorSuggestWidget.selectedBackground": "${base02}",
    "editorHoverWidget.background": "${base01}",
    "editorHoverWidget.border": "${base02}",
    "editorGroup.border": "${base02}",
    "editorGroupHeader.tabsBackground": "${background}",
    "editorGroupHeader.noTabsBackground": "${background}",
    "diffEditor.insertedTextBackground": "${green}25",
    "diffEditor.removedTextBackground": "${red}25",
    "scrollbarSlider.background": "${base02}80",
    "scrollbarSlider.hoverBackground": "${base03}80",
    "scrollbarSlider.activeBackground": "${accent}60",

    "tab.activeBackground": "${background}",
    "tab.activeForeground": "${foreground}",
    "tab.activeBorderTop": "${accent}",
    "tab.inactiveBackground": "${background}",
    "tab.inactiveForeground": "${muted}",
    "tab.hoverBackground": "${surface}",
    "tab.border": "${background}",
    "tab.unfocusedActiveForeground": "${base04}",
    "tab.unfocusedInactiveForeground": "${dim}",

    "titleBar.activeBackground": "${background}",
    "titleBar.activeForeground": "${foreground}",
    "titleBar.inactiveBackground": "${background}",
    "titleBar.inactiveForeground": "${muted}",
    "titleBar.border": "${base02}",
    "menu.background": "${base01}",
    "menu.foreground": "${foreground}",
    "menu.selectionBackground": "${base02}",
    "menu.selectionForeground": "${foreground}",
    "menu.separatorBackground": "${base02}",
    "menubar.selectionBackground": "${base02}",

    "activityBar.background": "${background}",
    "activityBar.foreground": "${foreground}",
    "activityBar.inactiveForeground": "${muted}",
    "activityBar.activeBorder": "${accent}",
    "activityBar.border": "${base02}",
    "activityBarBadge.background": "${accent}",
    "activityBarBadge.foreground": "${selection_foreground}",

    "sideBar.background": "${background}",
    "sideBar.foreground": "${foreground}",
    "sideBar.border": "${base02}",
    "sideBarTitle.foreground": "${foreground}",
    "sideBarSectionHeader.background": "${background}",
    "sideBarSectionHeader.foreground": "${foreground}",
    "sideBarSectionHeader.border": "${base02}",
    "list.activeSelectionBackground": "${base02}",
    "list.activeSelectionForeground": "${foreground}",
    "list.inactiveSelectionBackground": "${base01}",
    "list.inactiveSelectionForeground": "${foreground}",
    "list.hoverBackground": "${surface}",
    "list.hoverForeground": "${foreground}",
    "list.focusOutline": "${accent}80",
    "list.highlightForeground": "${accent}",
    "list.errorForeground": "${red}",
    "list.warningForeground": "${yellow}",
    "tree.indentGuidesStroke": "${base02}",
    "gitDecoration.modifiedResourceForeground": "${blue}",
    "gitDecoration.addedResourceForeground": "${green}",
    "gitDecoration.untrackedResourceForeground": "${green}",
    "gitDecoration.deletedResourceForeground": "${red}",
    "gitDecoration.ignoredResourceForeground": "${dim}",
    "gitDecoration.conflictingResourceForeground": "${yellow}",

    "statusBar.background": "${background}",
    "statusBar.foreground": "${foreground}",
    "statusBar.border": "${base02}",
    "statusBar.noFolderBackground": "${background}",
    "statusBar.debuggingBackground": "${accent}",
    "statusBar.debuggingForeground": "${selection_foreground}",
    "statusBarItem.hoverBackground": "${base02}",
    "statusBarItem.remoteBackground": "${accent}",
    "statusBarItem.remoteForeground": "${selection_foreground}",

    "panel.background": "${background}",
    "panel.border": "${base02}",
    "panelTitle.activeForeground": "${foreground}",
    "panelTitle.activeBorder": "${accent}",
    "panelTitle.inactiveForeground": "${muted}",
    "terminal.background": "${background}",
    "terminal.foreground": "${foreground}",
    "terminalCursor.foreground": "${cursor}",
    "terminal.selectionBackground": "${selection_background}55",
    "terminal.ansiBlack": "${color0}",
    "terminal.ansiRed": "${color1}",
    "terminal.ansiGreen": "${color2}",
    "terminal.ansiYellow": "${color3}",
    "terminal.ansiBlue": "${color4}",
    "terminal.ansiMagenta": "${color5}",
    "terminal.ansiCyan": "${color6}",
    "terminal.ansiWhite": "${color7}",
    "terminal.ansiBrightBlack": "${color8}",
    "terminal.ansiBrightRed": "${color9}",
    "terminal.ansiBrightGreen": "${color10}",
    "terminal.ansiBrightYellow": "${color11}",
    "terminal.ansiBrightBlue": "${color12}",
    "terminal.ansiBrightMagenta": "${color13}",
    "terminal.ansiBrightCyan": "${color14}",
    "terminal.ansiBrightWhite": "${color15}",

    "input.background": "${base01}",
    "input.foreground": "${foreground}",
    "input.border": "${base02}",
    "input.placeholderForeground": "${dim}",
    "inputOption.activeBorder": "${accent}",
    "dropdown.background": "${base01}",
    "dropdown.foreground": "${foreground}",
    "dropdown.border": "${base02}",
    "button.background": "${accent}",
    "button.foreground": "${selection_foreground}",
    "button.hoverBackground": "${accent_dim}",
    "button.secondaryBackground": "${base02}",
    "button.secondaryForeground": "${foreground}",
    "badge.background": "${accent}",
    "badge.foreground": "${selection_foreground}",
    "checkbox.background": "${base01}",
    "checkbox.border": "${base02}",
    "quickInput.background": "${base01}",
    "quickInput.foreground": "${foreground}",
    "quickInputList.focusBackground": "${base02}",
    "pickerGroup.foreground": "${accent}",
    "pickerGroup.border": "${base02}",
    "keybindingLabel.foreground": "${foreground}",
    "notifications.background": "${base01}",
    "notifications.foreground": "${foreground}",
    "notifications.border": "${base02}",
    "breadcrumb.foreground": "${muted}",
    "breadcrumb.focusForeground": "${foreground}",
    "breadcrumb.activeSelectionForeground": "${accent}",
    "minimap.selectionHighlight": "${selection_background}60",
    "peekView.border": "${accent}",
    "peekViewEditor.background": "${base01}",
    "peekViewResult.background": "${base01}",
    "peekViewTitle.background": "${base01}"
  },
  "tokenColors": [
    { "scope": ["comment", "punctuation.definition.comment"], "settings": { "foreground": "${base03}", "fontStyle": "italic" } },
    { "scope": ["string", "string.quoted", "string.template", "markup.inline.raw"], "settings": { "foreground": "${green}" } },
    { "scope": ["constant.character.escape", "string.regexp"], "settings": { "foreground": "${cyan}" } },
    { "scope": ["constant.numeric", "constant.language", "constant.language.boolean"], "settings": { "foreground": "${base09}" } },
    { "scope": ["constant", "variable.other.constant", "variable.other.enummember"], "settings": { "foreground": "${base09}" } },
    { "scope": ["keyword", "storage", "storage.type", "storage.modifier", "keyword.control"], "settings": { "foreground": "${magenta}" } },
    { "scope": ["keyword.operator", "punctuation.accessor"], "settings": { "foreground": "${cyan}" } },
    { "scope": ["entity.name.function", "support.function", "meta.function-call", "variable.function"], "settings": { "foreground": "${blue}" } },
    { "scope": ["entity.name.type", "entity.name.class", "support.type", "support.class", "entity.other.inherited-class"], "settings": { "foreground": "${yellow}" } },
    { "scope": ["variable", "variable.other", "meta.definition.variable"], "settings": { "foreground": "${foreground}" } },
    { "scope": ["variable.parameter"], "settings": { "foreground": "${pink}" } },
    { "scope": ["variable.language", "variable.language.this", "variable.language.self"], "settings": { "foreground": "${red}", "fontStyle": "italic" } },
    { "scope": ["variable.other.property", "variable.other.object.property", "support.variable.property", "entity.name.tag.yaml", "support.type.property-name"], "settings": { "foreground": "${base04}" } },
    { "scope": ["entity.name.tag"], "settings": { "foreground": "${red}" } },
    { "scope": ["entity.other.attribute-name"], "settings": { "foreground": "${yellow}" } },
    { "scope": ["entity.name.namespace", "entity.name.module"], "settings": { "foreground": "${yellow}" } },
    { "scope": ["meta.decorator", "punctuation.decorator", "entity.name.function.decorator", "meta.attribute"], "settings": { "foreground": "${cyan}" } },
    { "scope": ["punctuation", "meta.brace"], "settings": { "foreground": "${base04}" } },
    { "scope": ["invalid", "invalid.illegal"], "settings": { "foreground": "${red}" } },
    { "scope": ["markup.heading", "entity.name.section"], "settings": { "foreground": "${accent}", "fontStyle": "bold" } },
    { "scope": ["markup.bold"], "settings": { "fontStyle": "bold" } },
    { "scope": ["markup.italic"], "settings": { "fontStyle": "italic" } },
    { "scope": ["markup.underline.link", "string.other.link"], "settings": { "foreground": "${blue}" } },
    { "scope": ["markup.inserted"], "settings": { "foreground": "${green}" } },
    { "scope": ["markup.deleted"], "settings": { "foreground": "${red}" } },
    { "scope": ["markup.changed"], "settings": { "foreground": "${yellow}" } }
  ],
  "semanticTokenColors": {
    "variable": "${foreground}",
    "parameter": "${pink}",
    "property": "${base04}",
    "function": "${blue}",
    "method": "${blue}",
    "type": "${yellow}",
    "class": "${yellow}",
    "struct": "${yellow}",
    "enum": "${yellow}",
    "enumMember": "${base09}",
    "namespace": "${yellow}",
    "keyword": "${magenta}",
    "macro": "${cyan}",
    "*.readonly": "${base09}"
  }
}
