general {
    disable_loading_bar = true
    hide_cursor = true
}

background {
    monitor =
    color = rgb(${background_hex})
}

input-field {
    monitor =
    size = 300, 48
    outer_color = rgb(${color8_hex})
    inner_color = rgb(${color0_hex})
    font_color = rgb(${foreground_hex})
    check_color = rgb(${accent_hex})
    fail_color = rgb(${red_hex})
    placeholder_text = <span foreground="${foreground}">password</span>
    dots_size = 0.25
    dots_spacing = 0.3
    fade_on_empty = true
    position = 0, -40
    halign = center
    valign = center
}

label {
    monitor =
    text = $TIME
    color = rgb(${foreground_hex})
    font_size = 64
    font_family = JetBrainsMono Nerd Font
    position = 0, 80
    halign = center
    valign = center
}
