# Generated by themectl — do not edit by hand
# Colors only; keep structure minimal so hyprlock still works if you merge
# this into a fuller config.

general {
    disable_loading_bar = true
    hide_cursor = true
}

background {
    color = ${background}
}

input-field {
    monitor =
    size = 300, 48
    outer_color = ${color8}
    inner_color = ${color0}
    font_color = ${foreground}
    check_color = ${accent}
    fail_color = ${red}
    placeholder_text = <span foreground="${foreground}">password</span>
    dots_size = 0.25
    dots_spacing = 0.3
    fade_on_empty = true
    position = 0, -40
    halign = center
    valign = center
}

label {
    monitor =
    text = $TIME
    color = ${foreground}
    font_size = 64
    font_family = JetBrainsMono Nerd Font
    position = 0, 80
    halign = center
    valign = center
}
