general {
    hide_cursor = true
    ignore_empty_input = true
    text_trim = true
}

background {
    monitor =
    path = ${wallpaper}
    color = rgb(${background_hex})
    blur_passes = 3
    blur_size = 7
    noise = 0.0118
    contrast = 0.89
    brightness = 0.45
    vibrancy = 0.17
    vibrancy_darkness = 0.1
}

# card behind everything; kept well under output size so it centres correctly
shape {
    monitor =
    size = 520, 520
    color = rgba(${background_hex}D9)
    rounding = 26
    border_size = 2
    border_color = rgba(${accent_hex}59)
    rotate = 0
    xray = false
    position = 0, 0
    halign = center
    valign = center
    zindex = 1
}

image {
    monitor =
    path = ${logo}
    size = 132
    rounding = 0
    border_size = 0
    rotate = 0
    reload_time = -1
    position = 0, 144
    halign = center
    valign = center
    zindex = 5
}

label {
    monitor =
    text = cmd[update:30000] date +'<span weight="800" foreground="##${foreground_hex}">%H</span><span weight="200" foreground="##${accent_hex}">:%M</span>'
    color = rgb(${foreground_hex})
    shadow_size = 3
    shadow_color = rgba(0,0,0,0.5)
    shadow_boost = 1.2
    font_size = 92
    font_family = JetBrainsMono Nerd Font
    position = 0, -8
    halign = center
    valign = center
    zindex = 5
}

shape {
    monitor =
    size = 300, 2
    color = rgba(${accent_hex}99)
    rounding = 1
    border_size = 0
    rotate = 0
    position = 0, -87
    halign = center
    valign = center
    zindex = 5
}

label {
    monitor =
    text = cmd[update:30000] date +'%A, %d %B'
    color = rgb(${dim_hex})
    font_size = 15
    font_family = JetBrainsMono Nerd Font
    position = 0, -114
    halign = center
    valign = center
    zindex = 5
}

input-field {
    monitor =
    size = 300, 46
    outline_thickness = 2
    dots_size = 0.24
    dots_spacing = 0.32
    dots_center = true
    dots_rounding = -1
    outer_color = rgba(${muted_hex}99)
    inner_color = rgb(${surface_hex})
    font_color = rgb(${foreground_hex})
    check_color = rgb(${accent_hex})
    fail_color = rgb(${red_hex})
    capslock_color = rgb(${yellow_hex})
    fail_text = <i>$FAIL</i>
    placeholder_text = <span foreground="##${muted_hex}">$USER</span>
    hide_input = false
    rounding = 12
    fade_on_empty = false
    position = 0, -187
    halign = center
    valign = center
    zindex = 20
}

label {
    monitor =
    text = cmd[update:60000] cut -d. -f1 /proc/uptime | awk '{printf "up %dh %dm", $1/3600, ($1%3600)/60}'
    color = rgb(${muted_hex})
    font_size = 11
    font_family = JetBrainsMono Nerd Font
    position = 0, 26
    halign = center
    valign = bottom
    zindex = 5
}
