general {
    hide_cursor = true
}

background {
    monitor =
    color = rgb(${lock_bg})
}

input-field {
    monitor =
    size = 260, 48
    outline_thickness = 1
    dots_size = 0.28
    dots_spacing = 0.3
    outer_color = rgb(${lock_accent})
    inner_color = rgb(${lock_bg})
    font_color = rgb(${lock_text})
    check_color = rgb(${lock_check})
    fail_color = rgb(${lock_fail})
    placeholder_text = <i>...</i>
    fade_on_empty = true
    position = 0, -40
    halign = center
    valign = center
}

label {
    monitor =
    text = $TIME
    color = rgb(${lock_accent})
    font_size = 72
    font_family = FiraCode Nerd Font Mono
    position = 0, 120
    halign = center
    valign = center
}

label {
    monitor =
    text = ${lock_label}
    color = rgb(${lock_text})
    font_size = 11
    font_family = FiraCode Nerd Font Mono
    position = 0, -140
    halign = center
    valign = center
}
