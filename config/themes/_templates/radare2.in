# radare2 colours from the dots palette (themectl); sourced by ~/.radare2rc
ec comment rgb:${muted_hex}
ec args rgb:${foreground_hex}
ec fname rgb:${accent_hex}
ec floc rgb:${accent_hex}
ec fline rgb:${dim_hex}
ec flag rgb:${cyan_hex}
ec label rgb:${cyan_hex}
ec help rgb:${muted_hex}
ec flow rgb:${blue_hex}
ec flow2 rgb:${magenta_hex}
ec prompt rgb:${accent_hex}
ec addr rgb:${dim_hex}
ec input rgb:${foreground_hex}
ec invalid rgb:${red_hex}
ec other rgb:${foreground_hex}
ec b0x00 rgb:${dim_hex}
ec b0x7f rgb:${cyan_hex}
ec b0xff rgb:${red_hex}
ec math rgb:${yellow_hex}
ec bin rgb:${cyan_hex}
ec btext rgb:${foreground_hex}
ec push rgb:${magenta_hex}
ec pop rgb:${magenta_hex}
ec crypto rgb:${pink_hex}
ec jmp rgb:${green_hex}
ec cjmp rgb:${green_hex}
ec call rgb:${accent_hex}
ec ucall rgb:${accent_hex}
ec ret rgb:${red_hex}
ec nop rgb:${dim_hex}
ec trap rgb:${red_hex}
ec swi rgb:${pink_hex}
ec cmp rgb:${yellow_hex}
ec reg rgb:${blue_hex}
ec creg rgb:${blue_hex}
ec num rgb:${yellow_hex}
ec mov rgb:${foreground_hex}
ec var rgb:${magenta_hex}
ec var.name rgb:${magenta_hex}
ec var.type rgb:${blue_hex}
ec var.addr rgb:${cyan_hex}
ec linehl rgb:${surface_hex}
ec graph.box rgb:${dim_hex}
ec graph.box2 rgb:${accent_hex}
ec graph.box3 rgb:${magenta_hex}
ec graph.box4 rgb:${muted_hex}
ec graph.true rgb:${green_hex}
ec graph.false rgb:${red_hex}
ec graph.trufae rgb:${blue_hex}
ec graph.current rgb:${accent_hex}
ec graph.traced rgb:${yellow_hex}
ec ai.read rgb:${green_hex}
ec ai.write rgb:${red_hex}
ec ai.exec rgb:${accent_hex}
ec ai.seq rgb:${magenta_hex}
ec ai.ascii rgb:${yellow_hex}
