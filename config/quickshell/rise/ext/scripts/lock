#!/usr/bin/env bash
# The session lock (hypridle's lock_cmd): rise's themed lock screens
# (ExtLock.qml, ported from dhrruvsharma/shell, matching the desktop theme),
# or the classic grimoire lock (quickshell -c lock) once chosen with
#   qs -c rise ipc call lockscreen engine classic
# Themed is the default, so a wiped ~/.local/state doesn't silently fall back.
state=${XDG_STATE_HOME:-$HOME/.local/state}/dots/shell/ext/lock-engine
if [ "$(cat "$state" 2>/dev/null)" = classic ]; then
    exec quickshell -c lock
fi
exec quickshell -p "$HOME/.config/quickshell/rise/ExtLock.qml"
