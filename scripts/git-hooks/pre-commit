#!/usr/bin/env bash
set -uo pipefail
fail=0

# 1. Every .nix file the flake references must be TRACKED — flakes only see
#    git content, so an untracked module fails with "path does not exist".
while read -r ref; do
    f="${ref#./}"
    [ -e "$f" ] || { echo "pre-commit: flake references missing file: $f"; fail=1; continue; }
    git ls-files --error-unmatch "$f" >/dev/null 2>&1 || {
        echo "pre-commit: flake references UNTRACKED file: $f  (git add it)"; fail=1; }
done < <(grep -oE '\./[A-Za-z0-9_./-]+\.nix' flake.nix | sort -u)

#    modules/ is imported by directory listing, so an untracked module there is
#    not an error — it is silently left out of the system. Refuse that too.
untracked=$(git ls-files --others --exclude-standard -- modules/ | grep '\.nix$')
if [ -n "$untracked" ]; then
    echo "pre-commit: untracked module(s) would be silently skipped (git add them):"
    echo "$untracked" | sed 's/^/    /'
    fail=1
fi

# 2. Legacy hyprctl dispatch strings fail SILENTLY under the Lua config
#    (hyprctl still exits 0), so nothing else would catch these.
if grep -rn "hyprctl dispatch" --include="*.conf" --include="*.jsonc" --include="*.sh" \
     --include="*.lua" config/ 2>/dev/null | grep -v "hl\.dsp" | grep -q .; then
    echo "pre-commit: legacy 'hyprctl dispatch' string(s) — these fail silently:"
    grep -rn "hyprctl dispatch" --include="*.conf" --include="*.jsonc" --include="*.sh" \
      --include="*.lua" config/ 2>/dev/null | grep -v "hl\.dsp" | sed 's/^/    /'
    fail=1
fi

# 3. QML: unresolved id/property references render as a blank element with
#    nothing in the journal and nothing from qmllint.
if command -v python3 >/dev/null; then
    # qmllint for the syntax pass, from the same Qt the shell runs on
    if [ -z "${QMLLINT:-}" ] && command -v nix >/dev/null; then
        decl=$(nix build --no-link --print-out-paths --no-warn-dirty \
            .#nixosConfigurations.nixos.pkgs.qt6.qtdeclarative 2>/dev/null) \
            && export QMLLINT="$decl/bin/qmllint"
    fi
    python3 "$(dirname "$0")/../qml-check.py" || fail=1
fi

# 4. Full eval — catches duplicate attrs, bad option names, type errors.
#    Evaluating only the nixos host let a broken homeConfigurations output sit
#    unnoticed, so every output that builds an activation package is checked.
# CI runs this hook too; there whoami is the runner, not the flake's username.
user="${DOTS_USERNAME:-$(whoami)}"
if command -v nix >/dev/null; then
    for out in \
        "nixosConfigurations.nixos.config.system.build.toplevel" \
        "homeConfigurations.\"${user}@linux\".activationPackage" \
        "homeConfigurations.\"${user}@linux-desktop\".activationPackage" \
        "homeConfigurations.\"${user}@aarch64-linux\".activationPackage" \
        "homeConfigurations.\"${user}@mac\".activationPackage" \
        "darwinConfigurations.mac.system"
    do
        echo "pre-commit: evaluating $out"
        nix eval --no-warn-dirty ".#${out}.drvPath" \
            >/dev/null 2>/tmp/pre-commit-eval.log || {
            echo "pre-commit: EVAL FAILED for $out — see /tmp/pre-commit-eval.log"
            tail -15 /tmp/pre-commit-eval.log; fail=1; }
    done
fi

# 5. Lint. statix reads statix.toml (repeated_keys / empty_pattern disabled —
#    both are style opinions that would make these modules less readable).
#    deadnix: -L skips module-signature args like { config, lib, pkgs, ... },
#    which are idiomatic and not dead code.
command -v statix  >/dev/null && { statix check . || fail=1; }
command -v deadnix >/dev/null && { deadnix --fail -L --exclude templates . || fail=1; }

[ $fail -eq 0 ] && echo "pre-commit: ok"
exit $fail
